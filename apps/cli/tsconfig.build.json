  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",

    "declaration": false,
    "sourceMap": true,

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
