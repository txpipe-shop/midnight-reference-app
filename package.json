{
  "name": "midnight-sentinel",
  "version": "1.0.0",
  "author": "",
  "description": "",
  "scripts": {
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yaml,yml}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify:protocol:local": "pnpm --filter @midnight-sentinel/protocol-verification verify:local",
    "verify:protocol:reward-split": "pnpm --filter @midnight-sentinel/protocol-verification verify:reward-split",
    "verify:protocol:devnet:sponsorship": "pnpm --filter @midnight-sentinel/protocol-verification verify:devnet:sponsorship",
    "verify:protocol:devnet:composite": "pnpm --filter @midnight-sentinel/protocol-verification verify:devnet:composite",
    "verify:protocol:devnet:production": "pnpm --filter @midnight-sentinel/protocol-verification verify:devnet:production",
    "verify:protocol:all": "pnpm verify:protocol:local && pnpm verify:protocol:reward-split && pnpm verify:protocol:devnet:sponsorship && pnpm verify:protocol:devnet:composite && pnpm verify:protocol:devnet:production"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "turbo": "^2.8.3",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.29.0"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "overrides": {
      "@midnight-ntwrk/ledger-v8": "8.0.3"
    }
  }
}
