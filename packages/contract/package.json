{
  "name": "@midnight-sentinel/contract",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "browser": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js",
      "require": "./dist/providers.js"
    },
    "./sponsorship-verification": {
      "types": "./dist/sponsorship-verification.d.ts",
      "import": "./dist/sponsorship-verification.js",
      "require": "./dist/sponsorship-verification.js"
    },
    "./composite-sponsorship-verification": {
      "types": "./dist/composite-sponsorship-verification.d.ts",
      "import": "./dist/composite-sponsorship-verification.js",
      "require": "./dist/composite-sponsorship-verification.js"
    }
  },
  "scripts": {
    "compact": "compact compile +0.31.1 src/sentinel.compact ./src/managed/sentinel",
    "compact:no-zk": "compact compile +0.31.1 --skip-zk src/sentinel.compact ./src/managed/sentinel",
    "compact:sponsorship": "compact compile +0.31.1 src/verification/sponsorship.compact ./src/managed/sponsorship",
    "compact:sponsorship:no-zk": "compact compile +0.31.1 --skip-zk src/verification/sponsorship.compact ./src/managed/sponsorship",
    "compact:sponsorship:composite": "compact compile +0.31.1 src/verification/composite-sponsorship.compact ./src/managed/composite-sponsorship && compact compile +0.31.1 src/verification/composite-target.compact ./src/managed/composite-target",
    "compact:sponsorship:composite:no-zk": "compact compile +0.31.1 --skip-zk src/verification/composite-sponsorship.compact ./src/managed/composite-sponsorship && compact compile +0.31.1 --skip-zk src/verification/composite-target.compact ./src/managed/composite-target",
    "verify:sponsorship:runtime": "pnpm compact:sponsorship:no-zk && node --import ../../apps/cli/node_modules/tsx/dist/loader.mjs src/verification/sponsorship-runtime-check.ts",
    "verify:sponsorship:production:runtime": "pnpm compact:no-zk && node --import ../../apps/cli/node_modules/tsx/dist/loader.mjs src/verification/sentinel-sponsorship-runtime-check.ts",
    "verify:sponsorship": "pnpm compact:sponsorship && tsc --project tsconfig.build.json && cp -R src/managed/sponsorship dist/managed/ && pnpm --dir ../wallet build && pnpm --dir ../../apps/cli verify:sponsorship",
    "verify:sponsorship:composite": "pnpm compact:sponsorship:composite && tsc --project tsconfig.build.json && cp -R src/managed/composite-sponsorship src/managed/composite-target dist/managed/ && pnpm --dir ../wallet build && pnpm --dir ../../apps/cli verify:sponsorship:composite",
    "verify:sponsorship:production": "pnpm compact && pnpm compact:sponsorship:composite && tsc --project tsconfig.build.json && mkdir -p dist/managed/sentinel dist/managed/composite-target && cp -Rf src/managed/sentinel/. dist/managed/sentinel/ && cp -Rf src/managed/composite-target/. dist/managed/composite-target/ && pnpm --dir ../api build && pnpm --dir ../wallet build && pnpm --dir ../../apps/cli verify:sponsorship:production",
    "clean": "rm -rf dist .turbo src/managed node_modules",
    "clear": "rm -rf dist src/managed",
    "check": "pnpm compact:no-zk && mkdir -p dist/managed/sentinel && tsc --project ./tsconfig.build.json && cp -Rf ./src/managed/sentinel/. ./dist/managed/sentinel/ && cp ./src/sentinel.compact ./dist",
    "build": "pnpm compact && mkdir -p dist/managed/sentinel && tsc --project ./tsconfig.build.json && cp -Rf ./src/managed/sentinel/. ./dist/managed/sentinel/ && cp ./src/sentinel.compact ./dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-sentinel/wallet": "workspace:*",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
