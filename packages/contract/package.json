{
  "name": "@midnight-sentinel/contract",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "browser": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "compact": "compact compile src/sentinel.compact ./src/managed/sentinel",
    "compact:no-zk": "compact compile --skip-zk src/sentinel.compact ./src/managed/sentinel",
    "clean": "rm -rf dist",
    "check": "pnpm clean && pnpm compact:no-zk && mkdir -p dist && tsc --project ./tsconfig.build.json && cp -Rf ./src/managed ./dist/managed && cp ./src/sentinel.compact ./dist",
    "build": "pnpm clean && pnpm compact && mkdir -p dist && tsc --project ./tsconfig.build.json && cp -Rf ./src/managed ./dist/managed && cp ./src/sentinel.compact ./dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "^2.4.0",
    "@midnight-ntwrk/compact-runtime": "^0.14.0",
    "@midnight-ntwrk/midnight-js-contracts": "^3.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^3.1.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^3.1.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^3.1.0",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "^3.1.0",
    "@midnight-ntwrk/midnight-js-types": "^3.0.0",
    "@midnight-sentinel/wallet": "workspace:*",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
