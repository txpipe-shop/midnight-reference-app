pragma language_version 0.20;

import CompactStandardLibrary;

enum NumberComp {
  GT,
  LT,
  EQ,
  NEQ,
  GTE,
  LTE,
}

enum BooleanComp {
  EQ,
  NEQ,
}

struct NumberProp {
  op: NumberComp;
  value: Uint<64>;
}

struct BooleanProp {
  op: BooleanComp;
  value: Boolean;
}

type Proposition = Either<NumberProp, BooleanProp>;

type Conjunction<#n> = Maybe<Vector<n, Maybe<Proposition>>>;
type Disjunction<#n, #m> = Vector<m, Conjunction<n>>;
type Rules = Disjunction<20,10>;

export ledger rules: Rules;

constructor(contractRules: Rules) {
  rules = disclose(contractRules);
}

circuit checkNumberProp(rule: NumberProp, input: Uint<64>): Boolean {
  if(rule.op == NumberComp.GTE) {
    return rule.value >= input;
  } else if (rule.op == NumberComp.LTE) {
    return rule.value <= input;
  } else if (rule.op == NumberComp.LT) {
    return rule.value < input;
  } else if (rule.op == NumberComp.GT) {
    return rule.value > input;
  } else if (rule.op == NumberComp.NEQ) {
    return rule.value != input;
  } else {
    return rule.value == input;
  }
}

circuit checkBooleanProp(rule: BooleanProp, input: Uint<64>): Boolean {
    return true;
}

circuit checkProp(rule: Proposition, input: Uint<64>): Boolean {
  if(rule.is_left) {
      return checkNumberProp(rule.left, input);
  } else {
    return checkBooleanProp(rule.right, input);
  }
}

circuit satAnd(rule: Maybe<Proposition>, input: Uint<64>): Boolean {
  if (rule.is_some) {
    return checkProp(rule.value, input);
  }
  // && neutral
  return true;
}

circuit satOr(clause: Conjunction<20>, input: Uint<64>): Boolean {
  if (clause.is_some) {
    return fold((acc, and) => acc && satAnd(and, input), true, clause.value);
  }
  // || neutral
  return false;
}

export circuit satisifes(input: Uint<64>): Boolean {
  return fold((acc, or) => acc || satOr(or, input), false, rules);
}
