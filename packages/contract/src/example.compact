pragma language_version 0.20;

import CompactStandardLibrary;


enum NumberComp {
  GT,
  LT,
  EQ,
  NEQ,
  GTE,
  LTE,
}

struct NumberProp {
  op: NumberComp;
  value: Uint<64>;
}

type AndRules<#n> = Vector<n, Maybe<NumberProp>>;
type Conjunction<#n> = Maybe<AndRules<n>>;
type Disjunction<#n, #m> = Vector<m, Conjunction<n>>;
type Rules = Disjunction<2,2>;

export ledger rules: Rules;

constructor(contractRules: Rules) {
  rules = disclose(contractRules);
}

circuit satAnd(rule: Maybe<NumberProp>, input: Uint<64>): Boolean {
  if (rule.is_some) {
    // TODO: add more types of rules
    if(rule.value.op == NumberComp.GTE) {
      return rule.value.value >= input;
    } else if (rule.value.op == NumberComp.LTE) {
      return rule.value.value <= input;
    } else if (rule.value.op == NumberComp.LT) {
      return rule.value.value < input;
    } else if (rule.value.op == NumberComp.GT) {
      return rule.value.value > input;
    } else if (rule.value.op == NumberComp.NEQ) {
      return !(rule.value.value == input);
    }{
      return rule.value.value == input;
    }
  }
  // && neutral
  return true;
}

circuit satOr(clause: Conjunction<2>, input: Uint<64>): Boolean {
  if (clause.is_some) {
    return fold((acc, and) => acc && satAnd(and, input), true, clause.value);
  }
  // || neutral
  return false;
}

export circuit satisifes(input: Uint<64>): Boolean {
  return fold((acc, or) => acc || satOr(or, input), false, rules);
}
