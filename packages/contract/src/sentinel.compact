pragma language_version 0.23;

import CompactStandardLibrary;

export struct SponsorshipReceipt {
  targetAddress: Bytes<32>;
  targetEntryPointHash: Bytes<32>;
  targetCommunicationCommitment: Field;
}

///////// LEDGER /////////
export ledger owner: Bytes<32>;

export sealed ledger sponsorshipSponsorId: Bytes<32>;

export sealed ledger sponsorshipAcceptedColor: Bytes<32>;

export sealed ledger sponsorshipFixedPrice: Uint<64>;

export sealed ledger sponsorshipPolicyHash: Bytes<32>;

export ledger sponsorshipEnabled: Boolean;

export ledger sponsorshipRevenue: Uint<128>;

export ledger sponsorshipPurchases: Counter;

export ledger sponsorshipReceipts: Map<Bytes<32>, SponsorshipReceipt>;

///////// CONSTRUCTOR /////////
constructor(
  sponsorId: Bytes<32>,
  acceptedColor: Bytes<32>,
  fixedPrice: Uint<64>,
  policyHash: Bytes<32>
) {
  assert(fixedPrice > 0, "Sponsorship price must be positive");

  const sk = localSecretKey();
  owner = disclose(publicKey(sk));
  sponsorshipSponsorId = disclose(sponsorId);
  sponsorshipAcceptedColor = disclose(acceptedColor);
  sponsorshipFixedPrice = disclose(fixedPrice);
  sponsorshipPolicyHash = disclose(policyHash);
  sponsorshipEnabled = disclose(true);
  sponsorshipRevenue = disclose(0);
}

///////// EXPORTED CIRCUITS /////////

export circuit purchaseSponsorship(
  purchaseId: Bytes<32>,
  payment: ShieldedCoinInfo,
  targetAddress: Bytes<32>,
  targetEntryPointHash: Bytes<32>,
  targetCommunicationCommitment: Field
): [] {
  const publicPurchaseId = disclose(purchaseId);
  const publicPayment = disclose(payment);
  const publicTargetAddress = disclose(targetAddress);
  const publicEntryPointHash = disclose(targetEntryPointHash);
  const publicTargetCommitment = disclose(targetCommunicationCommitment);

  assert(sponsorshipEnabled, "Sponsorship is paused");
  assert(publicPayment.color == sponsorshipAcceptedColor, "Wrong sponsorship payment asset");
  assert(publicPayment.value == sponsorshipFixedPrice, "Wrong sponsorship payment amount");
  assert(!sponsorshipReceipts.member(publicPurchaseId), "Duplicate sponsorship purchase");

  receiveShielded(publicPayment);

  sponsorshipRevenue =
    (sponsorshipRevenue + (publicPayment.value as Uint<128>)) as Uint<128>;
  sponsorshipPurchases.increment(1);
  sponsorshipReceipts.insert(
    publicPurchaseId,
    SponsorshipReceipt {
      targetAddress: publicTargetAddress,
      targetEntryPointHash: publicEntryPointHash,
      targetCommunicationCommitment: publicTargetCommitment
    }
  );
}

export circuit setSponsorshipEnabled(enabled: Boolean): [] {
  assert(isOwner(), "You are not the owner of this contract.");
  sponsorshipEnabled = disclose(enabled);
}

///////// HELPER CIRCUITS /////////

circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "dust-sponsorship:pk:"), sk]);
}

circuit isOwner(): Boolean {
  const sk = localSecretKey();
  const pk = publicKey(sk);
  return pk == owner;
}

///////// WITNESSES /////////
witness localSecretKey(): Bytes<32>;
