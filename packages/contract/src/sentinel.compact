pragma language_version 0.22;

import CompactStandardLibrary;

///////// LEDGER /////////
export ledger owner: ZswapCoinPublicKey;
export ledger delegators: Map<ZswapCoinPublicKey, Uint<128>>;
export ledger shieldedVault: QualifiedShieldedCoinInfo;
export ledger rewardsVault: QualifiedShieldedCoinInfo;
export ledger hasShielded: Boolean;
export ledger hasRewards: Boolean;

///////// CONSTRUCTOR /////////
constructor(key: ZswapCoinPublicKey) {
  owner = disclose(key);
  hasShielded = disclose(false);
  hasRewards = disclose(false);
}

///////// EXPORTED CIRCUITS /////////

export circuit delegate(key: ZswapCoinPublicKey, coin: ShieldedCoinInfo): [] {
  assert(coin.value > 0, "Deposit amount must be positive");

  receiveShielded(disclose(coin));

  if (!hasShielded) {
      shieldedVault.writeCoin(
          disclose(coin),
          right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
      );
      hasShielded = true;
  } else {
      shieldedVault.writeCoin(
          mergeCoinImmediate(shieldedVault, disclose(coin)),
          right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
      );
  }

  delegators.insert(disclose(key), disclose(coin.value));
}

///////// WITNESSES /////////
witness localSecretKey(): Bytes<32>;