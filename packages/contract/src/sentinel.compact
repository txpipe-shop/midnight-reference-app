pragma language_version 0.22;

import CompactStandardLibrary;

///////// LEDGER /////////
export ledger owner: ZswapCoinPublicKey;
export ledger delegators: Map<ZswapCoinPublicKey, Uint<128>>;
export ledger shieldedVault: QualifiedShieldedCoinInfo;
export ledger rewardsVault: QualifiedShieldedCoinInfo;
export ledger hasShielded: Boolean;
export ledger hasRewards: Boolean;

///////// CONSTRUCTOR /////////
constructor(key: ZswapCoinPublicKey) {
  owner = disclose(key);
  hasShielded = disclose(false);
  hasRewards = disclose(false);
}


///////// EXPORTED CIRCUITS /////////

///////// WITNESSES /////////
witness localSecretKey(): Bytes<32>;