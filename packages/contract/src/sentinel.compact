pragma language_version 0.22;

import CompactStandardLibrary;

///////// TYPES /////////
export struct Input {
  uint: Uint<64>;
  boolean: Boolean;
  bytes32: Bytes<32>;
  field: Field;
}

export enum Ord {
  GT,
  LT,
  EQ,
  NEQ,
  GTE,
  LTE,
}

export enum Eq {
  EQ,
  NEQ,
}

export struct NumberProp {
  op: Ord;
  value: Uint<64>;
}

export struct BooleanProp {
  op: Eq;
  value: Boolean;
}

export struct ByteProp {
  op: Eq;
  value: Bytes<32>;
}

export struct FieldProp {
  op: Eq;
  value: Field;
}

export struct NullifierProp {
  op: Eq;
  nullifier: Bytes<32>;
}

export type Proposition = Either<NumberProp, Either<BooleanProp, Either<ByteProp, Either<FieldProp, NullifierProp>>>>;
type Conjunction<#n> = Maybe<Vector<n, Maybe<Proposition>>>;
type Disjunction<#n, #m> = Vector<m, Conjunction<n>>;
export type Rules = Disjunction<2,2>;

///////// LEDGER /////////
export ledger rules: Map<Bytes<32>, Rules>;
export ledger admin: Either<ZswapCoinPublicKey, ContractAddress>;

///////// CONSTRUCTOR /////////
constructor(pubKey: ZswapCoinPublicKey) {
  const deployAdmin = left<ZswapCoinPublicKey, ContractAddress>(pubKey);
  admin = disclose(deployAdmin);
}

///////// EXPORTED CIRCUITS /////////
export circuit addRule(owner: ZswapCoinPublicKey, nonce: Bytes<32>, rule: Rules): [] {
  const ruleKey = hashCoinPublicKey(owner, nonce);
  // TODO: add whitelist
  rules.insert(disclose(ruleKey), disclose(rule));
}

export circuit removeRule(publicKey: ZswapCoinPublicKey, nonce: Bytes<32>): [] {
  const ruleKey = hashCoinPublicKey(publicKey, nonce);
  assert(isRuleOwner(ruleKey) || isAdmin(), "You are not the rule owner, the admin of this contract or the rule does not exist");
  rules.remove(disclose(ruleKey));
}

export circuit transferAdmin(newAdmin: ZswapCoinPublicKey): [] {
  assert(isAdmin(), "You are not the admin of this contract");
  admin = disclose(left<ZswapCoinPublicKey, ContractAddress>(newAdmin));
}

export circuit mintSpecialToken(
  rulesAndInputs: Vector<2, [Bytes<32>, Input]>,
  address: UserAddress,
  domainSep: Bytes<32>
): [] {
  assert(fold((acc, [rule, input]) => acc && satisfies(rule, input), true, disclose(rulesAndInputs)), "Rules not satisfied");

  const amount: Uint<64> = 1;
  const recipient = right<ContractAddress, UserAddress>(address);
  const _coin = mintUnshieldedToken(disclose(domainSep), amount, disclose(recipient));
}

///////// HELPER CIRCUITS /////////
circuit hashCoinPublicKey(cpk: ZswapCoinPublicKey, nonce: Bytes<32>): Bytes<32> {
  return persistentCommit<Bytes<32>>(cpk.bytes, nonce);
}

circuit isRuleOwner(ruleKey: Bytes<32>): Boolean {
  return rules.member(disclose(ruleKey));
}

circuit isAdmin(): Boolean {
  return ownPublicKey() == disclose(admin.left);
}

circuit satisfies(ruleKey: Bytes<32>, input: Input): Boolean {
  return fold((acc, or) => acc || satOr(or, input), false, rules.lookup(ruleKey));
}

circuit checkNumberProp(rule: NumberProp, input: Input): Boolean {
  if (rule.op == Ord.GTE) {
    return input.uint >= rule.value;
  } else if (rule.op == Ord.LTE) {
    return input.uint <= rule.value;
  } else if (rule.op == Ord.LT) {
    return input.uint < rule.value;
  } else if (rule.op == Ord.GT) {
    return input.uint > rule.value;
  } else if (rule.op == Ord.NEQ) {
    return input.uint != rule.value;
  } else {
    return input.uint == rule.value;
  }
}

circuit checkBooleanProp(rule: BooleanProp, input: Input): Boolean {
  return rule.op == Eq.EQ ? input.boolean == rule.value : input.boolean != rule.value;
}

circuit checkByteProp(rule: ByteProp, input: Input): Boolean {
  return rule.op == Eq.EQ ? input.bytes32 == rule.value : input.bytes32 != rule.value;
}

circuit checkFieldProp(rule: FieldProp, input: Input): Boolean {
  return rule.op == Eq.EQ ? input.field == rule.value : input.field != rule.value;
}

circuit checkNullifierProp(rule: NullifierProp): Boolean {
  const computed = disclose(nullifier(secretKey()));
  return rule.op == Eq.EQ ? rule.nullifier == computed : rule.nullifier != computed;
}

circuit checkProp(rule: Proposition, input: Input): Boolean {
  if (rule.is_left) {
      return checkNumberProp(rule.left, input);
  } else if (rule.right.is_left) {
    return checkBooleanProp(rule.right.left, input);
  } else if (rule.right.right.is_left) {
    return checkByteProp(rule.right.right.left, input);
  } else if (rule.right.right.right.is_left){
    return checkFieldProp(rule.right.right.right.left, input);
  } else {
    return checkNullifierProp(rule.right.right.right.right);
  }
}

circuit satAnd(rule: Maybe<Proposition>, input: Input): Boolean {
  if (rule.is_some) {
    return checkProp(rule.value, input);
  }
  // && neutral
  return true;
}

circuit satOr(clause: Conjunction<2>, input: Input): Boolean {
  if (clause.is_some) {
    return fold((acc, and) => acc && satAnd(and, input), true, clause.value);
  }
  // || neutral
  return false;
}

export circuit nullifier(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>(
    [pad(32, "nullifier"), sk]
  );
}

///////// WITNESSES /////////
witness secretKey(): Bytes<32>;